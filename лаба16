# 1. Теоретический вопрос (терминология / применение):
#        Аббревиатура RR в digital-маркетинге может означать два разных показателя. Назовите их и объясните разницу.
#        В каком контексте применяется каждый из них?
# 2. Теоретический вопрос (формула / интерпретация):
# Компания заработала 3 600 000 рублей за последние 90 дней. Рассчитайте Run Rate(годовую проекцию выручки).
# Если план на год составляет 20 000 000 рублей, какой процент плана выполнен в пересчёте на год?
def calculate_run_rate(revenue, period_days, annual_plan=None):
    daily_revenue = revenue / period_days
    run_rate = daily_revenue * 365
    result = f"Run Rate = {run_rate:,.0f} руб.".replace(",", " ")

    if annual_plan is not None:
        percent = (run_rate / annual_plan) * 100
        result += f"\nВыполнение годового плана: {percent:.1f}% (план: {annual_plan:,.0f} руб.)".replace(",", " ")

    return result


