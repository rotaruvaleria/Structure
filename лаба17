# 1. Теоретический вопрос (терминология / применение):
#                Что такое скорость сканирования (crawl budget) поисковым роботом?
#                Почему для крупных сайтов (интернет-магазинов с миллионами страниц) управление crawl budget является критически важной задачей?
#                Как директива robots.txt и тег noindex помогают управлять краулингом?
# 2. Теоретический вопрос (формула / интерпретация):
# Яндекс-бот посещает сайт Lamoda.ru примерно 150 000 раз в сутки (страниц в очереди наобход).
# Сайт имеет 2 400 000 страниц. Рассчитайте, сколько дней потребуется боту для полного обхода сайта.
# Если исключить 600 000 страниц (фильтры/дубли) через robots.txt, как изменится время полного обхода?
def crawl_budget_analysis(total_pages, daily_crawl_rate, excluded_pages=0):
    pages_to_crawl = total_pages - excluded_pages
    days = pages_to_crawl / daily_crawl_rate

    if excluded_pages == 0:
        return f"{int(days)} дней"

    original_days = total_pages / daily_crawl_rate
    days_saved = original_days - days
    percent_saved = (days_saved / original_days) * 100

    return (f"{int(days)} дней (экономия {int(days_saved)} дня, "
            f"−{int(percent_saved)}%)")


